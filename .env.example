# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Vercel deployment
# ---------------------------------------------------------------------------

# Server-side only. Read by the Vercel Function at api/deepseek.ts and never
# sent to the browser. Add it in Vercel under Settings > Environment Variables
# (for Preview and Production). For local development put it in .env.local and
# run `vercel dev` — plain `npm run dev` has no serverless runtime, so
# /api/deepseek will not exist there.
DEEPSEEK_API_KEY=""

# Optional DeepSeek overrides.
DEEPSEEK_MODEL="deepseek-flash"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Optional build-time default for the Google Apps Script Web App database URL.
# VITE_* values are inlined into the client bundle and are therefore public:
# this must be a deployment URL, never a secret. A URL saved in the app's
# Google Apps Script screen takes precedence over this default.
VITE_APPS_SCRIPT_URL=""
